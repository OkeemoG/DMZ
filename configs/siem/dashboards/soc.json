            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"dmz\", ident=~\"modsecurity|suricata|ulogd\"} != \"ModSecurity: Warning\" | json | line_format `{{ if eq .ident \"suricata\" }}IDS       {{ .client }} -> {{ .dest_ip }}:{{ .dest_port }}   {{ .alert_signature }}{{ else if eq .ident \"ulogd\" }}{{ .host }}   {{ .client }} -> {{ .dst }}{{ if .dpt }}:{{ .dpt }}{{ end }} {{ .proto }}   verworfen ({{ .fw_rule }}){{ else }}WAF       {{ .client }} -> {{ .uri }}   geblockt, Score {{ .score }}{{ end }}`",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false,
        "prettifyLogMessage": false
      },
